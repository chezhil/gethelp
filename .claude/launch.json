{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web"
      ],
      "port": 8081
    },
    {
      "name": "prod-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "-s",
        "dist",
        "-l",
        "8090"
      ],
      "port": 8090
    }
  ]
}
